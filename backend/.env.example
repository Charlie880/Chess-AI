# Copy to backend/.env and fill in. Never commit the real .env.

# Accounts and game history need these two. Without them the engine endpoints
# still work; /auth and /games return 503.
MONGO_URI=
MONGO_DB=chess_ai
JWT_SECRET=
JWT_EXPIRE_MINUTES=10080

# Optional: path to a local Stockfish binary for Hard mode.
# STOCKFISH_PATH=
