# Copy to backend/.env and fill in. Never commit the real .env.

# Signing identities. Required for accounts, guests and room tickets - without
# it nobody can join a room, because a room needs to know who you are.
JWT_SECRET=
JWT_EXPIRE_MINUTES=10080

# Storing games. Without these the engines and rooms still work; /auth/login,
# /auth/register and /games return 503 and nothing is recorded.
MONGO_URI=
MONGO_DB=chess_ai

# Browser origins allowed to call the API. Behind a tunnel this is the page's
# public hostname, not localhost.
# CORS_ORIGINS=https://your-page-tunnel.trycloudflare.com

# Optional: path to a local Stockfish binary for Hard mode.
# STOCKFISH_PATH=
